# Telegram Userbot Credentials
# Get from https://my.telegram.org/apps
TELEGRAM_APP_ID=your_app_id_here
TELEGRAM_APP_API_HASH=your_app_hash_here
TELEGRAM_PHONE=+91xxxxxxxxxx        # Phone number with country code

# Telegram Channel to listen on (numeric ID, e.g. 234567890) MTProto client format not the Bot
# Use a Telegram API client or @userinfobot to find the channel ID.
TELEGRAM_CHANNEL_ID=234567890

# Anthropic API Key
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAlgo Configuration
# Ensure OpenAlgo server is running before starting the bot.
OPENALGO_URL=http://127.0.0.1:5000
OPENALGO_API_KEY=your_openalgo_api_key_here

# Session storage (do NOT commit session.json — it's in .gitignore)
SESSION_FILE_PATH=session.json

# DRY_RUN=true routes all orders through OpenAlgo Analyzer mode (no real trades).
# Set to false ONLY when ready for live trading.
DRY_RUN=true

# Trade Configuration
TRADE_LOT_SIZE=1
OPENING_SL_PERCENT=5.0